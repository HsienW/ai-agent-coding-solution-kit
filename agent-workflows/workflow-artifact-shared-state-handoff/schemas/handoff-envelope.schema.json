{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/handoff-envelope.schema.json",
  "title": "Structured Handoff Envelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "handoffId",
    "changeId",
    "runId",
    "from",
    "to",
    "stage",
    "reason",
    "requiredInputRefs",
    "expectedOutputKind",
    "acceptanceCriteriaRefs",
    "onSuccess",
    "onFailure",
    "onConflict",
    "requiresHumanApproval"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.0\\.[0-9]+$"
    },
    "handoffId": {
      "type": "string",
      "pattern": "^handoff:[a-z0-9][a-z0-9._:-]*$"
    },
    "changeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[a-z0-9][a-z0-9._-]{2,120}$"
    },
    "from": {
      "enum": [
        "coordinator",
        "implementer",
        "reviewer",
        "readiness",
        "archive",
        "human",
        "automation"
      ]
    },
    "to": {
      "enum": [
        "coordinator",
        "implementer",
        "reviewer",
        "readiness",
        "archive",
        "human"
      ]
    },
    "stage": {
      "enum": [
        "plan-change",
        "review-plan",
        "apply-change",
        "review-result",
        "fix-from-review",
        "readiness-check",
        "archive-change",
        "manual-gate"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "requiredInputRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "expectedOutputKind": {
      "enum": [
        "coordinator_result",
        "implementation_result",
        "review_result",
        "readiness_result",
        "archive_result"
      ]
    },
    "acceptanceCriteriaRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactRef"
      }
    },
    "onSuccess": {
      "$ref": "#/$defs/transition"
    },
    "onFailure": {
      "$ref": "#/$defs/transition"
    },
    "onConflict": {
      "$ref": "#/$defs/transition"
    },
    "requiresHumanApproval": {
      "type": "boolean"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "transition": {
      "type": "object",
      "required": [
        "phase",
        "owner"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "owner": {
          "enum": [
            "coordinator",
            "implementer",
            "reviewer",
            "readiness",
            "archive",
            "human",
            "automation"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": [
        "refId",
        "type",
        "uri"
      ],
      "properties": {
        "refId": {
          "type": "string"
        },
        "type": {
          "enum": [
            "openspec",
            "schema",
            "runtime-state",
            "handoff",
            "agent-result",
            "evidence",
            "diff",
            "summary",
            "source",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "pattern": "^(repo://|runtime://|artifact://|evidence://|summary://|schema://)[A-Za-z0-9._~:/?#@!$&'()*+,;=%-]+$"
        },
        "description": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
